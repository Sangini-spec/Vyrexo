        "path": "src/types/index.ts",
        "content": "export interface FlightRoute {\n  id: string;\n  airline: string;\n  flightNumber: string;\n  from: string;\n  to: string;\n  departureTime: string;\n  arrivalTime: string;\n  duration: string;\n  price: number;\n  stops: number;\n}\n\nexport interface BookingDetails {\n  flightId: string;\n  passengerName: string;\n  cabinClass: \"Economy\" | \"Business\" | \"First\";\n  seat: string;\n  luggage: boolean;\n  priority: boolean;\n  totalPrice: number;\n}\n",
