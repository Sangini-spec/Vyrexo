      {
        "path": "package.json",
        "content": "{\n  \"name\": \"skywings-flight-booking-air-travel-system\",\n  \"version\": \"1.0.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"build\": \"bun build src/components/App.tsx --outdir dist\",\n    \"test\": \"bun test tests/app.test.ts\"\n  },\n  \"dependencies\": {\n    \"react\": \"^19.0.0\",\n    \"react-dom\": \"^19.0.0\"\n  }\n}",
