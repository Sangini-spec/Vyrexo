# Vyrexo Environment Configuration

# =============================================================================
# AI Engine
# =============================================================================
# Choose a provider: "ollama" (local, free, unlimited — no API key needed),
# "groq", "gemini", "openrouter", or "openai". All but gemini use the
# OpenAI-compatible path; any of them accept LLM_BASE_URL / LLM_API_KEY overrides.
LLM_PROVIDER=ollama

# --- Ollama (local, unlimited; install from https://ollama.com, then `ollama pull <model>`) ---
# No key needed. IMPORTANT: pick a model that emits NATIVE tool-calls on Ollama —
# llama3.1 / llama3.3 / mistral-nemo do; qwen2.5-coder does NOT (it returns tool
# calls as plain text, which breaks the agents). Size to your VRAM:
#   ~6GB VRAM -> llama3.1:8b   |   ~12GB -> mistral-nemo / llama3.3 (q4)   |   24GB+ -> llama3.3:70b
LLM_MODEL_HEAVY=llama3.1:8b
LLM_MODEL_LIGHT=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1   # default; override if Ollama runs elsewhere

# --- Groq (free key: https://console.groq.com/keys) ---
# LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# openai/gpt-oss-120b (best quality, ~200k tokens/day) | llama-3.3-70b-versatile | qwen/qwen3-32b
# LLM_MODEL_HEAVY=openai/gpt-oss-120b
# LLM_MODEL_LIGHT=openai/gpt-oss-120b

# --- Gemini (alternative) ---
# LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL_HEAVY=gemini-2.5-pro
# LLM_MODEL_LIGHT=gemini-2.5-flash

# --- OpenRouter (alternative; many models, cheap paid or rate-limited free) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# LLM_MODEL_HEAVY=deepseek/deepseek-chat-v3.1
# LLM_MODEL_LIGHT=deepseek/deepseek-chat-v3.1

# =============================================================================
# Database (Supabase PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# =============================================================================
# Voice - Speech to Text (Whisper)
# =============================================================================
# Options: "local" (runs on machine) or "api" (OpenAI Whisper API)
STT_PROVIDER=local
WHISPER_MODEL_SIZE=base

# =============================================================================
# Voice - Text to Speech
# =============================================================================
# Options: "edge" (edge-tts, free unlimited) or "chatterbox" (local) or "pyttsx3" (offline)
TTS_PROVIDER=edge
TTS_VOICE=en-US-GuyNeural

# =============================================================================
# Server
# =============================================================================
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=info

# =============================================================================
# ChromaDB (Vector Store)
# =============================================================================
CHROMA_PERSIST_DIR=~/.vyrexo/chroma
