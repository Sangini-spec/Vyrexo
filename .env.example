# ==============================================================================
# VYREXO ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual API keys and secrets.
# Do NOT put secret values in this file as it is committed to source control.
# ==============================================================================

# Core AI Reasoning & Conversational Voice Engine (Google Gemini)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL_LIGHT=gemini-2.5-flash
LLM_MODEL_HEAVY=gemini-2.5-pro

# Primary Coding Agent (Anthropic Claude Sonnet 5.5)
ANTHROPIC_API_KEY=
ANTHROPIC_CODING_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=20000

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# Voice & Speech Synthesis (TTS / STT) — 3-Tier Conversational Hierarchy
# Tier 1 (Primary): Gnani AI (Vachana Timbre v3.0 — used until credits/quota are exhausted)
# Tier 2 (First Fallback): ElevenLabs (activates automatically once Gnani credits are exhausted)
# Tier 3 (Second Fallback): Google Gemini API TTS (activates once both Gnani & ElevenLabs credits are exhausted)
GNANI_KEY=
GNANI_API_KEY=
GNANI_MODEL=timbre-v3.0
ELEVEN_LABS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
TTS_PROVIDER=gnani
TTS_VOICE=adam
STT_PROVIDER=browser
WHISPER_MODEL_SIZE=base

# Optional Alternative LLMs & Integrations
GITHUB_TOKEN=
CHROMA_PERSIST_DIR=.vyrexo/chroma

# Server Runtime & Port
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info