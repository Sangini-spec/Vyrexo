# ==============================================================================
# VYREXO ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual API keys and secrets.
# Do NOT put secret values in this file as it is committed to source control.
# ==============================================================================

# Core AI Reasoning & Conversational Voice Engine (Google Gemini)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL_LIGHT=gemini-2.5-flash
LLM_MODEL_HEAVY=gemini-2.5-pro

# Primary Coding Agent (Anthropic Claude Sonnet 5.5)
ANTHROPIC_API_KEY=
ANTHROPIC_CODING_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=20000

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# Voice & Speech Synthesis (TTS / STT)
# Primary Engine: ElevenLabs (always attached for emotional voice awareness)
# Automatic Fallback: Google Gemini API TTS (activates seamlessly if ElevenLabs credits/quota are exceeded)
ELEVEN_LABS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4_turbo
TTS_PROVIDER=elevenlabs
TTS_VOICE=adam
STT_PROVIDER=browser
WHISPER_MODEL_SIZE=base

# Optional Alternative LLMs & Integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GITHUB_TOKEN=
CHARIOT_API_KEY=
CHARIOT_BASE_URL=
CHARIOT_MODEL=
CHROMA_PERSIST_DIR=.vyrexo/chroma

# Server Runtime & Port
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info