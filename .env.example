# Vyrexo Environment Configuration

# =============================================================================
# AI Engine
# =============================================================================
# Choose a provider: "groq" (free, fast, generous limits — recommended),
# "gemini", "openrouter", or "openai". All but gemini use the OpenAI-compatible
# path; "openrouter"/"openai" also accept LLM_BASE_URL / LLM_API_KEY overrides.
LLM_PROVIDER=groq

# --- Groq (free key: https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL_HEAVY=llama-3.3-70b-versatile
LLM_MODEL_LIGHT=llama-3.3-70b-versatile

# --- Gemini (alternative) ---
# LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL_HEAVY=gemini-2.5-pro
# LLM_MODEL_LIGHT=gemini-2.5-flash

# --- OpenRouter (alternative; many models, some free) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# LLM_MODEL_HEAVY=deepseek/deepseek-chat-v3.1
# LLM_MODEL_LIGHT=meta-llama/llama-3.3-70b-instruct

# =============================================================================
# Database (Supabase PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# =============================================================================
# Voice - Speech to Text (Whisper)
# =============================================================================
# Options: "local" (runs on machine) or "api" (OpenAI Whisper API)
STT_PROVIDER=local
WHISPER_MODEL_SIZE=base

# =============================================================================
# Voice - Text to Speech
# =============================================================================
# Options: "edge" (edge-tts, free unlimited) or "chatterbox" (local) or "pyttsx3" (offline)
TTS_PROVIDER=edge
TTS_VOICE=en-US-GuyNeural

# =============================================================================
# Server
# =============================================================================
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=info

# =============================================================================
# ChromaDB (Vector Store)
# =============================================================================
CHROMA_PERSIST_DIR=~/.vyrexo/chroma
