# Vyrexo Frontend Environment Template (Safe to commit — no secrets)
# Copy to .env.local for local development or set in Render Environment Variables.

# Server-Side AI Provider Keys (Never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CODING_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
ELEVEN_LABS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
OPENAI_API_KEY=
CHARIOT_API_KEY=
GITHUB_TOKEN=

# Development & Demo Testing Quota Mode (true = unrestricted testing during demos)
VYREXO_UNRESTRICTED_TESTING=true

# Optional Public Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
